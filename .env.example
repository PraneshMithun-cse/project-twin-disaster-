# Server & Environment Setup
PORT=3000
ENVIRONMENT=development
APP_URL=http://localhost:3000
DEBUG=true

# AI Engine (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here

# Database & Realtime (Supabase)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_KEY=your_supabase_service_role_key_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# GIS, Radar & Satellite Integrations
MAPBOX_API_KEY=your_mapbox_token_here
OPENWEATHER_API_KEY=your_openweather_key_here
NASA_FIRMS_MAPKEY=your_nasa_firms_key_here
SENTINEL_SAR_API_KEY=your_sentinel_key_here
IMD_RADAR_API_URL=https://mausam.imd.gov.in/radar/

# Emergency Broadcast Credentials (SMS & FCM)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
FIREBASE_FCM_SERVER_KEY=your_fcm_server_key_here

# WhatsApp Emergency Broadcast (Facility Safety Blueprint module)
# Option A — Meta WhatsApp Cloud API
WHATSAPP_CLOUD_TOKEN=your_meta_permanent_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id_here
WHATSAPP_API_VERSION=v21.0
# Option B — Twilio WhatsApp (sandbox number works for testing)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Country code prepended to bare 10-digit numbers in an uploaded roster
DEFAULT_COUNTRY_CODE=+91
